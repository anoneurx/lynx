# LYNX — example environment.
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored and MUST NOT contain production secrets.
#
# Local dev values are intentionally weak and are rejected by the production
# config validator. Every secret below has a documented production source in
# docs/security/secrets.md.

# ── Core ────────────────────────────────────────────────────────────────────────
LYNX_ENV=development                     # development | staging | production
LYNX_LOG_LEVEL=info                      # trace | debug | info | warn | error
LYNX_LOG_FORMAT=json                     # json | pretty

# ── API ────────────────────────────────────────────────────────────────────────
LYNX_API_BIND=0.0.0.0:8080
LYNX_API_PUBLIC_URL=http://localhost:3000
LYNX_API_CORS_ORIGINS=http://localhost:3000
LYNX_API_TRUSTED_PROXY_DEPTH=0           # raise ONLY when behind our own LB
LYNX_API_MAX_QUERY_BYTES=512
LYNX_API_MAX_RESULTS=50

# ── Database ───────────────────────────────────────────────────────────────────
LYNX_DATABASE_URL=postgres://lynx:lynx_dev_only@localhost:5432/lynx
LYNX_DATABASE_MAX_CONNECTIONS=20
LYNX_DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── Redis (cache + rate limiting only; no durable data) ────────────────────────
LYNX_REDIS_URL=redis://localhost:6379/0
LYNX_REDIS_PERSISTENCE=false

# ── Search index ───────────────────────────────────────────────────────────────
LYNX_INDEX_DIR=/tmp/lynx-dev-index
LYNX_INDEX_SHARDS=1
LYNX_INDEX_MEMORY_BUDGET_MB=1024

# ── Ranking ────────────────────────────────────────────────────────────────────
LYNX_RANKING_CONFIG=config/development.toml
LYNX_RANKING_CONFIG_VERSION=dev-local

# ── Crawler ────────────────────────────────────────────────────────────────────
LYNX_CRAWLER_USER_AGENT=LynxBot/0.1 (+https://anoneurx.com/lynx/bot)
LYNX_CRAWLER_CONCURRENCY=8
LYNX_CRAWLER_MAX_RESPONSE_BYTES=5242880
LYNX_CRAWLER_TIMEOUT_MS=15000
LYNX_CRAWLER_ALLOWED_SCHEMES=http,https
LYNX_CRAWLER_SEEDS=config/seeds/development.toml

# ── Privacy (see PRIVACY.md §8 — weakening these requires an ADR) ──────────────
LYNX_PRIVACY_QUERY_LOGGING=false          # must remain false in every environment
LYNX_PRIVACY_RATE_LIMIT_ENABLED=true
LYNX_PRIVACY_RATE_LIMIT_PREFIX_BITS_V4=24
LYNX_PRIVACY_RATE_LIMIT_PREFIX_BITS_V6=48
LYNX_PRIVACY_RATE_LIMIT_SALT_TTL_HOURS=24
LYNX_PRIVACY_RESPONSE_CACHE_ENABLED=true
LYNX_PRIVACY_RESPONSE_CACHE_TTL_SECONDS=120

# ── Privacy: rate-limit salt (local dev only; production uses the secret store)
# Regenerate locally with: openssl rand -base64 32
LYNX_RATE_LIMIT_SALT=dev-insecure-salt-change-me-0000000000=
LYNX_CACHE_KEY_SECRET=dev-insecure-cache-secret-change-me=

# ── Observability ──────────────────────────────────────────────────────────────
LYNX_METRICS_BIND=0.0.0.0:9090
LYNX_TRACING_ENABLED=false
LYNX_TRACING_ENDPOINT=
LYNX_TRACING_SAMPLE_RATIO=0.01

# ── AI (optional, off by default) ──────────────────────────────────────────────
LYNX_AI_ENABLED=false
LYNX_AI_PROVIDER=none                    # none | openai-compatible | self-hosted
LYNX_AI_ENDPOINT=
LYNX_AI_MODEL=off
LYNX_AI_API_KEY=
LYNX_AI_MAX_SOURCE_TOKENS=6000
LYNX_AI_DAILY_TOKEN_BUDGET=2000000

# ── Admin ──────────────────────────────────────────────────────────────────────
# Local dev only. Production admin access is VPN + SSO (docs/security/authentication.md)
LYNX_ADMIN_ENABLE_BASIC_AUTH=true
LYNX_ADMIN_USER=dev
LYNX_ADMIN_PASSWORD=dev-insecure-change-me