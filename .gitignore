/target
**/target
**/node_modules
.pnpm-store
.pnpm-debug.log*

# build output
/dist
/build
/out
/.next
/.astro
coverage/
*.tsbuildinfo

# index and crawl artifacts — never commit a crawl snapshot or index
/data
*.index
*.snap
/temp
/tmp

# environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
!**/testdata/*.pem
/infra-state
*.tfstate
*.tfstate.*

# crawl run dumps may contain third-party content — never commit
/crawl-dumps
/crawl-dumps/**
/logs
/logs/**

# editors & OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# local databases
postgres-data/
redis-data/